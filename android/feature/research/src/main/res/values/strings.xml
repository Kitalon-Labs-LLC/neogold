    <string name="r07_cd_encrypted">Encrypted export</string>
    <string name="r07_title">Export study data</string>
    <string name="r07_intro">Creates an encrypted export archive (.zip) with the study data and research photos. It holds participant codes and dates, with no names, birth dates or register numbers.</string>
    <string name="r07_point_encrypt">• Encrypted on this phone: all study data and photos are encrypted before they leave (AES-256-GCM). The archive header lists the study code and the counts.</string>
    <string name="r07_point_wrap">• Only the study coordinator can open it: the key is wrapped to the coordinator\'s offline key (HPKE, X25519).</string>
    <string name="r07_point_lost">• If the drive is lost, the records cannot be read without the coordinator\'s offline private key.</string>
    <string name="r07_point_deid">• Pseudonymised: only participant codes and dates are included. No names, birth dates or facility register numbers.</string>
    <string name="r07_cd_missing_key">Missing key</string>
    <string name="r07_no_key">The export key is missing from the study profile. An encrypted export cannot be made.</string>
