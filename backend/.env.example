# NeoGold Study Intake Backend - Environment Configuration
# Copy this file to .env and adjust values for local development:
#   cp .env.example .env

# Database connection URL (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neogold

# Public API Base URL
PUBLIC_BASE_URL=http://localhost:8000/v1

# Secret for HMAC enrollment codes (K12)
# REQUIRED: Must be at least 32 characters of random text (or server refuses to start)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENROLLMENT_CODE_SECRET=dev-secret-0123456789abcdef0123456789abcdef

# Trusted reverse-proxy IP addresses for forwarded client headers
FORWARDED_ALLOW_IPS=127.0.0.1,172.30.0.10

# Path to trust list (relative to repository root or backend directory)
TRUST_LIST_PATH=../config/trust-list.json

# Directory to store uploaded research images
IMAGE_STORE_DIR=./data/images

# Optional database URLs for specialized roles
# PURGE_DATABASE_URL=
# EXPORT_DATABASE_URL=

