#!/bin/sh
# NeoGold rule (CLAUDE.md, Commits): no AI attribution on any commit.
# Self-contained on purpose, so it works in every worktree and on every branch.
# The same rule runs in CI: tools/check_commit_attribution.py.
#
# Enable it once per clone:   git config core.hooksPath tools/hooks
if grep -i -E '^[[:space:]]*co-authored-by:.*(claude|anthropic)|@anthropic\.com|generated with.*claude' "$1" > /dev/null 2>&1; then
  echo "commit-msg: rejected. NeoGold rule (CLAUDE.md, Commits): no AI attribution on any commit." >&2
  echo "Remove the Co-Authored-By / Generated-with line and commit again." >&2
  exit 1
fi
exit 0
