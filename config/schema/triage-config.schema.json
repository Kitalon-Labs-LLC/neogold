{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitalonlabs.com/schema/triage-config.schema.json",
  "title": "NeoGold Triage Configuration Schema",
  "description": "Validation schema for NeoGold triage configuration (docs/4_System_Architecture.md Section 6.1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "configVersion",
    "guideline",
    "units",
    "triageEnabled",
    "validUntil",
    "clinicalSignoff",
    "scope",
    "hardRules",
    "phototherapyThresholds",
    "bloodTestZone",
    "recheck",
    "maxIntervalWidth",
    "qualityThresholds"
  ],
  "properties": {
    "configVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{1,2}\\.[0-9]+(-[a-z0-9.]+)?$",
      "description": "Semantic release or draft configuration version (e.g. 2026.10.0-draft or 2027.01.0)."
    },
    "guideline": {
      "type": "string",
      "minLength": 1,
      "description": "Clinical guideline identifier (e.g. AAP-2022)."
    },
    "units": {
      "type": "string",
      "enum": ["mg/dL", "umol/L"],
      "description": "Units of measurement for bilirubin concentration."
    },
    "triageEnabled": {
      "type": "boolean",
      "description": "Master switch for screening triage output. If false, triage returns unavailable and refers to blood test."
    },
    "validUntil": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Expiry date (YYYY-MM-DD). Triage is disabled if current device date is after validUntil."
    },
    "clinicalSignoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "signoffRecordSha256"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["DRAFT", "SIGNED"]
        },
        "signoffRecordSha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minGestationalAgeWeeks", "maxAgeHours"],
      "properties": {
        "minGestationalAgeWeeks": {
          "type": "integer",
          "const": 35,
          "description": "Minimum gestational age in completed weeks (35 for AAP-2022)."
        },
        "maxAgeHours": {
          "type": "number",
          "const": 336,
          "description": "Maximum postnatal age in hours (336 hours = 14 days)."
        }
      }
    },
    "hardRules": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "description": "Hard clinical exclusion and red-flag rules evaluated in strict order R1 to R5.",
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "when", "action"],
          "properties": {
            "id": { "const": "R1" },
            "when": { "type": "string" },
            "action": { "const": "REFER_URGENT" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "when", "action"],
          "properties": {
            "id": { "const": "R2" },
            "when": { "type": "string" },
            "action": { "const": "REFER_URGENT" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "when", "action"],
          "properties": {
            "id": { "const": "R3" },
            "when": { "type": "string" },
            "action": { "const": "CANNOT_SCREEN_BLOOD_TEST" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "when", "action"],
          "properties": {
            "id": { "const": "R4" },
            "when": { "type": "string" },
            "action": { "const": "CANNOT_SCREEN_BLOOD_TEST" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "when", "action"],
          "properties": {
            "id": { "const": "R5" },
            "when": { "type": "string" },
            "action": { "const": "CANNOT_SCREEN_CLINICAL_REVIEW" }
          }
        }
      ],
      "items": false
    },
    "phototherapyThresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ga35", "ga36", "ga38plus"],
      "description": "Phototherapy threshold lookup tables covering gestational ages 35 through 44 across 0 to 336 hours.",
      "properties": {
        "ga35": {
          "$ref": "#/$defs/thresholdTable",
          "description": "Gestational age 35 weeks band."
        },
        "ga36": {
          "$ref": "#/$defs/thresholdTable",
          "description": "Gestational age 36 to 37 weeks band."
        },
        "ga38plus": {
          "$ref": "#/$defs/thresholdTable",
          "description": "Gestational age 38 to 44 weeks band."
        }
      }
    },
    "bloodTestZone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["withinOfThreshold", "absoluteAtOrAbove"],
      "properties": {
        "withinOfThreshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Distance below threshold in mg/dL triggering blood test recommendation (AAP 2022: 3.0)."
        },
        "absoluteAtOrAbove": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Absolute upper bound threshold in mg/dL triggering blood test recommendation (AAP 2022: 15.0)."
        }
      }
    },
    "recheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["withinOfThreshold", "hours"],
      "properties": {
        "withinOfThreshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Distance below threshold in mg/dL triggering a recheck action (5.0 mg/dL)."
        },
        "hours": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "Interval in hours before recheck is recommended (24 hours)."
        }
      }
    },
    "maxIntervalWidth": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Maximum allowable prediction interval width (U - L) in mg/dL before flagging WIDE_INTERVAL (6.0 mg/dL)."
    },
    "qualityThresholds": {
      "type": "object",
      "description": "Camera and image quality gate thresholds (doc 4 Section 5.3)."
    }
  },
  "$defs": {
    "thresholdTable": {
      "type": "array",
      "minItems": 2,
      "description": "Ordered array of [ageHours, thresholdMgDl] points spanning 0 to 336 hours.",
      "prefixItems": [
        {
          "type": "array",
          "prefixItems": [
            { "type": "number", "const": 0 },
            { "type": "number", "minimum": 0 }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      ],
      "contains": {
        "type": "array",
        "prefixItems": [
          { "type": "number", "const": 336 },
          { "type": "number", "minimum": 0 }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      },
      "items": {
        "type": "array",
        "prefixItems": [
          { "type": "number", "minimum": 0, "maximum": 336 },
          { "type": "number", "minimum": 0 }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    }
  }
}
